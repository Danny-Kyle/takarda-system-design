        <!-- Note -->
        <mxCell id="note" value="Why this path is highest risk:&#xa;• Wrong PIN gate → double-use or false exhaust&#xa;• Stale cache after amendment → wrong grade&#xa;• Fallback storm at noon → primary overload&#xa;&#xa;Deliberately left out: web UI, USSD wording, bulk channel" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=10;align=left;spacing=6;" vertex="1" parent="1">
